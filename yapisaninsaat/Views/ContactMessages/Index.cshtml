@model IEnumerable<yapisaninsaat.Models.ContactMessage>
@{ ViewData["Title"] = "İletişim Mesajları"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-envelope me-2"></i>İletişim Mesajları</h2>
    <span class="badge bg-secondary fs-6">@Model.Count() mesaj</span>
</div>

@{
 var unreadCount = Model.Count(m => !m.IsRead);
}
@if (unreadCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
  <i class="fas fa-bell me-2"></i>
        <strong>@unreadCount</strong>&nbsp;adet okunmamış mesajınız var.
  </div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
 <table class="table table-hover mb-0">
  <thead>
         <tr>
        <th style="width:30px"></th>
            <th>Ad Soyad</th>
   <th>E-posta</th>
      <th>Telefon</th>
         <th>Mesaj Özeti</th>
         <th>Durum</th>
      <th>Tarih</th>
             <th class="text-end">İşlemler</th>
 </tr>
                </thead>
    <tbody>
      @foreach (var item in Model)
         {
          <tr class="@(!item.IsRead ? "table-warning" : "")">
       <td>
       @if (!item.IsRead)
        {
        <i class="fas fa-circle text-warning" style="font-size:8px" title="Yeni"></i>
  }
        </td>
       <td class="fw-bold">@item.FullName</td>
 <td>
        @if (!string.IsNullOrEmpty(item.Email))
         {
           <a href="mailto:@item.Email" class="text-decoration-none">@item.Email</a>
     }
      else
   {
         <span class="text-muted">—</span>
       }
     </td>
             <td>
   @if (!string.IsNullOrEmpty(item.Phone))
   {
           <a href="tel:@item.Phone" class="text-decoration-none">@item.Phone</a>
       }
      else
       {
  <span class="text-muted">—</span>
           }
                  </td>
 <td>
  <span class="text-muted" title="@item.Message">
            @(item.Message.Length > 50 ? item.Message.Substring(0, 50) + "..." : item.Message)
      </span>
 </td>
              <td>
    @if (item.IsRead)
          {
    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Okundu</span>
 }
           else
            {
              <span class="badge bg-warning text-dark"><i class="fas fa-envelope me-1"></i>Yeni</span>
         }
               </td>
      <td>
       <small>@item.CreatedDate.ToString("dd.MM.yyyy")<br /><span class="text-muted">@item.CreatedDate.ToString("HH:mm")</span></small>
      </td>
<td class="text-end">
    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detay"><i class="fas fa-eye"></i></a>
         <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Sil"><i class="fas fa-trash"></i></a>
                 </td>
            </tr>
  }
</tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
  <div class="text-center py-5 text-muted">
     <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
         <p>Henüz iletişim mesajı bulunmuyor.</p>
            </div>
        }
</div>
</div>
