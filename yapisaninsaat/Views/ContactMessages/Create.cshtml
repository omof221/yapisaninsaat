@model yapisaninsaat.Models.ContactMessage
@{ ViewData["Title"] = "Yeni Mesaj Oluştur"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-plus-circle me-2"></i>Yeni İletişim Mesajı</h2>
    <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Listeye Dön</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
   <div class="row">
    <div class="col-md-4 mb-3">
       <label asp-for="FullName" class="form-label"><i class="fas fa-user me-1 text-muted"></i>Ad Soyad <span class="text-danger">*</span></label>
   <input asp-for="FullName" class="form-control" placeholder="Ad Soyad giriniz" />
    <span asp-validation-for="FullName" class="text-danger small"></span>
      </div>
     <div class="col-md-4 mb-3">
              <label asp-for="Email" class="form-label"><i class="fas fa-envelope me-1 text-muted"></i>E-posta</label>
       <input asp-for="Email" class="form-control" type="email" placeholder="ornek@email.com" />
     </div>
        <div class="col-md-4 mb-3">
     <label asp-for="Phone" class="form-label"><i class="fas fa-phone me-1 text-muted"></i>Telefon</label>
   <input asp-for="Phone" class="form-control" placeholder="05XX XXX XX XX" />
  </div>
 </div>
  <div class="mb-3">
    <label asp-for="Message" class="form-label"><i class="fas fa-comment-alt me-1 text-muted"></i>Mesaj <span class="text-danger">*</span></label>
      <textarea asp-for="Message" class="form-control" rows="6" placeholder="Mesaj içeriğini giriniz..."></textarea>
 <span asp-validation-for="Message" class="text-danger small"></span>
   </div>
 <hr />
     <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Kaydet</button>
 <a asp-action="Index" class="btn btn-secondary ms-2">İptal</a>
     </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
