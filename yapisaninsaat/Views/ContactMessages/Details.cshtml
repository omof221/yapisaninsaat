@model yapisaninsaat.Models.ContactMessage
@{ ViewData["Title"] = "Mesaj Detayı"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-envelope-open me-2"></i>Mesaj Detayı</h2>
    <div>
  <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash me-1"></i>Sil</a>
   <a asp-action="Index" class="btn btn-secondary btn-sm ms-2"><i class="fas fa-arrow-left me-1"></i>Listeye Dön</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card h-100">
     <div class="card-body">
   <div class="text-center mb-4">
       <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;background:rgba(233,69,96,.1)">
    <i class="fas fa-user" style="font-size:24px;color:#e94560"></i>
     </div>
          <h5 class="mb-1">@Model.FullName</h5>
  <span class="badge @(Model.IsRead ? "bg-success" : "bg-warning text-dark")">
     @(Model.IsRead ? "Okundu" : "Yeni Mesaj")
     </span>
  </div>
 <hr />
   <div class="mb-3">
       <small class="text-muted d-block mb-1"><i class="fas fa-envelope me-1"></i>E-posta</small>
     @if (!string.IsNullOrEmpty(Model.Email))
      {
     <a href="mailto:@Model.Email" class="text-decoration-none fw-bold">@Model.Email</a>
  }
        else
      {
        <span class="text-muted">Belirtilmemiş</span>
       }
     </div>
   <div class="mb-3">
       <small class="text-muted d-block mb-1"><i class="fas fa-phone me-1"></i>Telefon</small>
    @if (!string.IsNullOrEmpty(Model.Phone))
       {
       <a href="tel:@Model.Phone" class="text-decoration-none fw-bold">@Model.Phone</a>
    }
        else
  {
   <span class="text-muted">Belirtilmemiş</span>
    }
         </div>
           <div>
   <small class="text-muted d-block mb-1"><i class="fas fa-clock me-1"></i>Tarih</small>
         <span class="fw-bold">@Model.CreatedDate.ToString("dd MMMM yyyy, HH:mm")</span>
  </div>
     </div>
   </div>
    </div>

    <div class="col-lg-8 mb-4">
   <div class="card h-100">
   <div class="card-body">
  <h6 class="text-muted mb-3"><i class="fas fa-comment-alt me-2"></i>Mesaj İçeriği</h6>
   <div class="p-4 rounded" style="background:#f8f9fa; border-left: 4px solid #e94560; min-height:200px; line-height:1.8; font-size:15px">
         @Model.Message
    </div>
     </div>
  </div>
  </div>
</div>

<div class="d-flex gap-2">
    @if (!string.IsNullOrEmpty(Model.Email))
    {
     <a href="mailto:@Model.Email?subject=Re: İletişim Formu" class="btn btn-primary"><i class="fas fa-reply me-1"></i>E-posta ile Yanıtla</a>
  }
    @if (!string.IsNullOrEmpty(Model.Phone))
    {
     <a href="tel:@Model.Phone" class="btn btn-outline-success"><i class="fas fa-phone me-1"></i>Ara</a>
    }
</div>
