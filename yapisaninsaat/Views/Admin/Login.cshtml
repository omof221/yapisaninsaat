@using yapisaninsaat.Models.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Admin Girişi";
    Layout = null; // Admin layout kullanma, sade sayfa
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Giriş</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #1a1a2e;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .login-card {
            background: white;
            border-radius: 12px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

            .login-card h2 {
                color: #1a1a2e;
                font-weight: 700;
                margin-bottom: 30px;
                text-align: center;
            }

        .btn-login {
            background: #1a1a2e;
            color: white;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
        }

            .btn-login:hover {
                background: #16213e;
                color: white;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <h2>🔐 Admin Paneli</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false)
            </div>
        }

        <form asp-action="Login" asp-controller="Admin" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <input asp-for="Username" class="form-control" placeholder="admin" />
            </div>

            <div class="mb-3">
                <label class="form-label">Şifre</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                <label class="form-check-label">Beni Hatırla</label>
            </div>

            <button type="submit" class="btn btn-login">Giriş Yap</button>
        </form>
    </div>
</body>
</html>