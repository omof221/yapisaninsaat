@model yapisaninsaat.Models.Setting

<section id="contact-page">
    <div class="cp-container">

        <div class="cp-header">
     <span class="cp-label">İletişim</span>
 <h1 class="cp-title">Bizimle İletişime Geçin</h1>
        <p class="cp-desc">Projeleriniz veya sorularınız için bize ulaşın. En kısa sürede dönüş yapacağız.</p>
        </div>

        <div class="cp-grid">

     @* ── SOL: İletişim Bilgileri ── *@
  <div class="cp-info">
     <div class="cp-info-card">
  @if (!string.IsNullOrEmpty(Model?.Address))
          {
         <div class="cp-info-item">
                   <div class="cp-info-icon">
           <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
                 <div>
  <div class="cp-info-label">Adres</div>
 <div class="cp-info-value">@Model.Address</div>
                 </div>
    </div>
 }
         @if (!string.IsNullOrEmpty(Model?.Phone))
          {
        <div class="cp-info-item">
       <div class="cp-info-icon">
       <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.1 11.1a19.79 19.79 0 01-3.07-8.67A2 2 0 012.01 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
     </div>
       <div>
             <div class="cp-info-label">Telefon</div>
      <a href="tel:@Model.Phone" class="cp-info-value cp-link">@Model.Phone</a>
</div>
             </div>
            }
                @if (!string.IsNullOrEmpty(Model?.Email))
 {
          <div class="cp-info-item">
     <div class="cp-info-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
 <div>
      <div class="cp-info-label">E-posta</div>
  <a href="mailto:@Model.Email" class="cp-info-value cp-link">@Model.Email</a>
          </div>
            </div>
          }

       @* Sosyal Medya *@
       @if (!string.IsNullOrEmpty(Model?.InstagramUrl) || !string.IsNullOrEmpty(Model?.LinkedInUrl) || !string.IsNullOrEmpty(Model?.TwitterUrl))
     {
     <div class="cp-social">
          <div class="cp-info-label" style="margin-bottom:10px">Sosyal Medya</div>
   <div class="cp-social-links">
      @if (!string.IsNullOrEmpty(Model.InstagramUrl))
             {
  <a href="@Model.InstagramUrl" target="_blank" rel="noopener" class="cp-social-btn" title="Instagram">
 <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
  </a>
        }
      @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
        {
            <a href="@Model.LinkedInUrl" target="_blank" rel="noopener" class="cp-social-btn" title="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
 </a>
         }
  @if (!string.IsNullOrEmpty(Model.TwitterUrl))
        {
           <a href="@Model.TwitterUrl" target="_blank" rel="noopener" class="cp-social-btn" title="Twitter">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
            </a>
             }
     </div>
  </div>
     }
     </div>
   </div>

        @* ── SAĞ: İletişim Formu ── *@
     <div class="cp-form-wrap">

       @* Başarılı gönderim sonrası gösterilecek mesaj *@
       <div id="contactSuccess" class="cp-success-box" style="display:none">
           <div class="cp-success-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#27ae60" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
           </div>
           <h3 class="cp-success-title">Teşekkürler!</h3>
        <p class="cp-success-text">Mesajınız başarılı şekilde gönderildi.<br/>En kısa zamanda size ulaşacağız.</p>
     <button type="button" class="cp-submit" onclick="document.getElementById('contactSuccess').style.display='none';document.getElementById('contactForm').style.display='block';" style="background:#27ae60;margin-top:16px">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 105.64-11.36L1 10"/></svg>
  Yeni Mesaj Gönder
           </button>
     </div>

       <form id="contactForm" method="post" action="/ContactMessages/CreatePublic">
     @Html.AntiForgeryToken()
  <div class="cp-form-title">Mesaj Gönderin</div>

        <div class="cp-field">
            <label for="FullName">Ad Soyad *</label>
  <input type="text" id="FullName" name="FullName" required maxlength="200" placeholder="Adınız Soyadınız" />
              </div>

             <div class="cp-field-row">
            <div class="cp-field">
         <label for="Email">E-posta</label>
      <input type="email" id="Email" name="Email" maxlength="200" placeholder="ornek@email.com" />
    </div>
      <div class="cp-field">
      <label for="Phone">Telefon</label>
                 <input type="tel" id="Phone" name="Phone" maxlength="20" placeholder="05XX XXX XX XX" />
          </div>
 </div>

            <div class="cp-field">
   <label for="Message">Mesajınız *</label>
       <textarea id="Message" name="Message" required rows="5" placeholder="Mesajınızı buraya yazın..."></textarea>
         </div>

   <button type="submit" class="cp-submit">
         <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      Gönder
          </button>

  <div id="contactResult" class="cp-result" style="display:none"></div>
     </form>
 </div>
    </div>
    </div>
</section>

<style>
    #contact-page {
        padding: 80px 0;
        background: #f8f9fa;
    }

    .cp-container {
   max-width: 1100px;
        margin: 0 auto;
      padding: 0 24px;
}

    .cp-header {
     text-align: center;
        margin-bottom: 56px;
    }

    .cp-label {
        display: inline-block;
        font-size: 11px;
font-weight: 700;
    letter-spacing: 0.25em;
  text-transform: uppercase;
        color: #c0392b;
     margin-bottom: 12px;
    }

    .cp-title {
     font-size: clamp(1.8rem, 3vw, 2.6rem);
        font-weight: 800;
   color: #1a1a1a;
        margin: 0 0 14px;
     letter-spacing: -0.02em;
    }

    .cp-desc {
        font-size: 15px;
   color: #666;
  margin: 0;
        line-height: 1.6;
    }

    .cp-grid {
     display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 40px;
        align-items: start;
    }

    /* ── İletişim Bilgileri ── */
    .cp-info-card {
    background: #1a1a2e;
        border-radius: 12px;
        padding: 36px 32px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .cp-info-item {
 display: flex;
        gap: 16px;
        align-items: flex-start;
    }

  .cp-info-icon {
        width: 44px;
        height: 44px;
        background: rgba(192,57,43,0.15);
 border-radius: 10px;
        display: flex;
        align-items: center;
 justify-content: center;
        flex-shrink: 0;
     color: #c0392b;
    }

    .cp-info-label {
     font-size: 11px;
    font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
        margin-bottom: 4px;
    }

    .cp-info-value {
        font-size: 15px;
        color: #fff;
        line-height: 1.5;
 }

    .cp-link {
  text-decoration: none;
  transition: color 0.2s;
    }

        .cp-link:hover {
          color: #c0392b;
        }

    .cp-social {
        padding-top: 8px;
        border-top: 1px solid rgba(255,255,255,0.08);
    }

    .cp-social-links {
   display: flex;
        gap: 10px;
    }

    .cp-social-btn {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: rgba(255,255,255,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.6);
        text-decoration: none;
  transition: all 0.2s;
  }

 .cp-social-btn:hover {
  background: #c0392b;
      color: #fff;
        }

    /* ── Form ── */
    .cp-form-wrap {
        background: #fff;
 border-radius: 12px;
        padding: 36px 32px;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }

    .cp-form-title {
        font-size: 18px;
  font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 24px;
    }

    .cp-field {
        margin-bottom: 18px;
        flex: 1;
    }

     .cp-field label {
   display: block;
  font-size: 12px;
            font-weight: 600;
      color: #555;
      margin-bottom: 6px;
     letter-spacing: 0.02em;
        }

        .cp-field input,
        .cp-field textarea {
    width: 100%;
            padding: 11px 14px;
      border: 1px solid #ddd;
   border-radius: 6px;
    font-size: 14px;
     font-family: inherit;
        color: #333;
            background: #fafafa;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

     .cp-field input:focus,
    .cp-field textarea:focus {
    outline: none;
         border-color: #c0392b;
     box-shadow: 0 0 0 3px rgba(192,57,43,0.1);
    background: #fff;
       }

   .cp-field textarea {
         resize: vertical;
            min-height: 120px;
      }

    .cp-field-row {
        display: flex;
        gap: 16px;
    }

    .cp-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    padding: 13px 32px;
        background: #c0392b;
 color: #fff;
   border: none;
border-radius: 6px;
     font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.06em;
 text-transform: uppercase;
        cursor: pointer;
 transition: background 0.2s, transform 0.15s;
    }

        .cp-submit:hover {
            background: #96281b;
          transform: translateY(-1px);
    }

    .cp-result {
        margin-top: 16px;
        padding: 12px 16px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
    }

    .cp-result-success {
        background: #d4edda;
 color: #155724;
        border: 1px solid #c3e6cb;
    }

    .cp-result-error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    /* ── Başarılı Gönderim Kutusu ── */
    .cp-success-box {
  text-align: center;
     padding: 48px 24px;
    }

    .cp-success-icon {
    display: inline-flex;
        align-items: center;
        justify-content: center;
  width: 80px;
    height: 80px;
 border-radius: 50%;
     background: rgba(39,174,96,0.1);
        margin-bottom: 24px;
        animation: cpSuccessPop 0.5s ease;
  }

    .cp-success-title {
     font-size: 24px;
  font-weight: 800;
   color: #1a1a1a;
        margin: 0 0 12px;
    }

  .cp-success-text {
        font-size: 15px;
        color: #666;
     line-height: 1.7;
        margin: 0;
    }

    @@keyframes cpSuccessPop {
        0% { transform: scale(0.5); opacity: 0; }
   70% { transform: scale(1.1); }
        100% { transform: scale(1); opacity: 1; }
  }

@@media (max-width: 768px) {
        #contact-page {
          padding: 56px 0;
        }

        .cp-grid {
     grid-template-columns: 1fr;
      gap: 28px;
        }

        .cp-field-row {
 flex-direction: column;
            gap: 0;
        }

  .cp-info-card {
            padding: 28px 24px;
        }

        .cp-form-wrap {
      padding: 28px 24px;
        }
    }
</style>

<script>
    document.getElementById('contactForm')?.addEventListener('submit', async function (e) {
     e.preventDefault();
const form = e.target;
        const result = document.getElementById('contactResult');
     const successBox = document.getElementById('contactSuccess');
        const btn = form.querySelector('.cp-submit');

     btn.disabled = true;
        btn.textContent = 'Gönderiliyor...';

        try {
  const resp = await fetch(form.action, {
     method: 'POST',
              body: new FormData(form)
     });

   if (resp.ok) {
        form.reset();
    form.style.display = 'none';
      successBox.style.display = 'block';
     } else {
     throw new Error();
        }
  } catch {
            result.style.display = 'block';
     result.className = 'cp-result cp-result-error';
    result.textContent = 'Mesaj gönderilemedi. Lütfen tekrar deneyin.';
      } finally {
   btn.disabled = false;
            btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Gönder';
        }
    });
</script>
