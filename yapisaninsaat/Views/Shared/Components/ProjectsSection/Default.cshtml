@model List<yapisaninsaat.Models.Project>
@{
    int status = ViewBag.Status;
    string sectionId = status == 0 ? "ongoing-projects" : "completed-projects";
    string sectionTitle = status == 0 ? "Devam Eden Projeler" : "Tamamlanan Projeler";
    string sectionDesc = status == 0 ? "Şu anda yapım aşamasında olan projelerimiz." : "Başarıyla teslim ettiğimiz tamamlanmış yapılar.";
}

@if (Model.Any())
{
    <section id="@sectionId" class="projects-section">
        <div class="ps-container">
            <div class="ps-header">
                <div class="ps-header-left">
                    <span class="ps-label">@(status == 0 ? "Devam Eden" : "Tamamlanan")</span>
                    <h2 class="ps-title">@sectionTitle</h2>
                    <p class="ps-desc">@sectionDesc</p>
                </div>
                <a class="ps-all-btn" href="/projeler?durum=@status">
                    Tümünü Gör
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
            </div>

            <div class="ps-grid">
                @foreach (var project in Model)
                {
                    var coverImage = project.ProjectImages?.FirstOrDefault(pi => pi.IsCover) ?? project.ProjectImages?.FirstOrDefault();
                    <a class="ps-card" href="/proje/@project.Slug">
                        <div class="ps-card-img">
                            @if (coverImage != null && !string.IsNullOrEmpty(coverImage.ImageUrl))
                            {
                                <img src="@coverImage.ImageUrl" alt="@project.Title" loading="lazy">
                            }
                            else
                            {
                                <div class="ps-card-placeholder">
                                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                                </div>
                            }
                            <div class="ps-card-overlay"></div>
                            @if (!string.IsNullOrEmpty(project.Category?.Title))
                            {
                                <span class="ps-card-badge">@project.Category.Title</span>
                            }
                        </div>
                        <div class="ps-card-body">
                            <div>
                                <h3 class="ps-card-title">@project.Title</h3>
                                @if (!string.IsNullOrEmpty(project.Location))
                                {
                                    <p class="ps-card-location">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
                                        @project.Location
                                    </p>
                                }
                            </div>
                            <div class="ps-card-cta">
                                <span>İncele</span>
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<style>
    .projects-section {
        padding: 80px 0;
        background: #fff;
    }

        .projects-section + .projects-section {
            background: #f7f7f7;
        }

    .ps-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 32px;
    }

    /* HEADER */
    .ps-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 40px;
    }

    .ps-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #c0392b;
        margin-bottom: 8px;
    }

    .ps-title {
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 800;
        color: #1a1a1a;
        margin: 0 0 8px;
        letter-spacing: -0.02em;
    }

    .ps-desc {
        font-size: 14px;
        color: #888;
        margin: 0;
    }

    .ps-all-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: transparent;
        border: 2px solid #1a1a1a;
        color: #1a1a1a;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 3px;
        white-space: nowrap;
        flex-shrink: 0;
        transition: background 0.2s, color 0.2s;
    }

        .ps-all-btn:hover {
            background: #1a1a1a;
            color: #fff;
        }

    /* GRID */
    .ps-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
    }

    /* KART */
    .ps-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid #eee;
        background: #fff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .ps-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.1);
        }

    .ps-card-img {
        position: relative;
        aspect-ratio: 4/3;
        overflow: hidden;
        background: #1a1a2e;
    }

        .ps-card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .ps-card:hover .ps-card-img img {
        transform: scale(1.05);
    }

    .ps-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 60%);
    }

    .ps-card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ps-card-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #c0392b;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 2px;
    }

    /* KART BODY */
    .ps-card-body {
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex: 1;
    }

    .ps-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0 0 5px;
        line-height: 1.3;
    }

    .ps-card-location {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        color: #999;
        margin: 0;
    }

    .ps-card-cta {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 700;
        color: #c0392b;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        flex-shrink: 0;
    }

    /* MOBİL */
    @@media (max-width: 768px) {
        .projects-section {
            padding: 56px 0;
        }

        .ps-container {
            padding: 0 20px;
        }

        .ps-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .ps-grid {
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px;
        }
    }

    @@media (max-width: 480px) {
        .ps-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
