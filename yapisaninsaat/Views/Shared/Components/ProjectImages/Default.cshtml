@model IEnumerable<yapisaninsaat.Models.PhotoExhibition>

<section id="photo-exhibition" class="projects-section">
    <div class="ps-container">
        <div class="ps-header">
            <div class="ps-header-left">
                <span class="ps-label">Galeri</span>
                <h2 class="ps-title">Fotoğraf Sergisi</h2>
                <p class="ps-desc">Çalışmalarımızdan ve şantiyelerimizden kareler.</p>
            </div>
            <a class="ps-all-btn" href="@Url.Action("Gallery", "PhotoExhibitions")">
                Tümünü Gör
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
        </div>

        <div class="ps-grid">
            @foreach (var item in Model)
            {
                <div class="ps-card photo-card">
                    <div class="ps-card-img">
                        <img src="@item.ImageUrl" alt="@(item.Title ?? "Fotoğraf")" loading="lazy">
                        <div class="ps-card-overlay"></div>
                        @if (!string.IsNullOrEmpty(item.Category))
                        {
                            <span class="ps-card-badge">@item.Category</span>
                        }
                        <div class="photo-zoom-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35M11 8v6M8 11h6" /></svg>
                        </div>
                    </div>
                    <div class="ps-card-body">
                        <div>
                            <h3 class="ps-card-title">@(item.Title ?? "İsimsiz Kare")</h3>
                            <p class="ps-card-location">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M3 12h1m8-9v1m8 8h1m-9 8v1M5.6 5.6l.7.7m12.1-.7-.7.7m.7 12.1-.7-.7M5.6 18.4l.7-.7" /></svg>
                                @(item.Category ?? "Genel")
                            </p>
                        </div>
                        <div class="ps-card-cta">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z" /><circle cx="12" cy="13" r="4" /></svg>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .photo-card .photo-zoom-icon {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        background: rgba(192,57,43,0.4);
        transition: opacity 0.3s;
    }

    .photo-card:hover .photo-zoom-icon {
        opacity: 1;
    }

    .photo-card:hover .ps-card-img img {
        transform: scale(1.08);
    }
</style>
